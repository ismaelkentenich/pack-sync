{
  "expo": {
    "name": "Pack Sync",
    "slug": "pack-sync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ismael.packsync",
      "icon": "./src/assets/icon.png"
    },
    "android": {
      "package": "com.ismael.packsync",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#6F5BD2"
      }
    },
    "extra": {
      "eas": {
        "projectId": "caaafd67-9eae-4f5a-b592-4c35547b3616"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#6F5BD2"
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker"
    ]
  }
}
