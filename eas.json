{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "hml"
      }
    },
    "production": {
      "distribution": "store",
      "env": {
        "APP_VARIANT": "prd"
      }
    }
  }
}
